<mxfile host="app.diagrams.net">
  <diagram id="sysarch-threetier" name="System Architecture (3-Tier)">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tt_title" value="Handyman West — Three-Tier System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tt_tier1" value="PRESENTATION LAYER — what users see" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1020" height="270" as="geometry" />
        </mxCell>
        <mxCell id="tt_actor_client" value="Clients&#10;(need repairs)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="tt_tier1">
          <mxGeometry x="30" y="45" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tt_actor_handy" value="Handymen&#10;(offer services)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="tt_tier1">
          <mxGeometry x="30" y="155" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tt_app" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Handyman West Mobile App&lt;/font&gt;&lt;/b&gt; — works on iPhone &amp;amp; Android&lt;br&gt;&lt;br&gt;&#8226; built from reusable interface components grouped by feature&#10;&lt;br&gt;&#8226; tab navigation for the main areas of the app&#10;&lt;br&gt;&#8226; step-by-step screens for flows like creating a booking&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888888&quot;&gt;(React Native · Expo · Expo Router)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="tt_tier1">
          <mxGeometry x="130" y="40" width="860" height="205" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_c_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;endArrow=open;endFill=1;strokeColor=#666666;strokeWidth=2.5;" edge="1" parent="tt_tier1" source="tt_actor_client" target="tt_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_h_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;endArrow=open;endFill=1;strokeColor=#666666;strokeWidth=2.5;" edge="1" parent="tt_tier1" source="tt_actor_handy" target="tt_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_t1_t2" value="sends requests over the internet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#4D4D4D;strokeWidth=4;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tt_tier1" target="tt_tier2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_tier2" value="APPLICATION LAYER — where decisions are made" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1020" height="330" as="geometry" />
        </mxCell>
        <mxCell id="tt_django" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Django Server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;models define the data  ·  serializers transform it  ·  views run the business rules&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888888&quot;&gt;(Django 5 · Django REST Framework)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="tt_tier2">
          <mxGeometry x="25" y="40" width="970" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_users" value="Users" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="25" y="185" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_handymen" value="Handymen" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="220" y="185" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_services" value="Services" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="415" y="185" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_bookings" value="Bookings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="610" y="185" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_locations" value="Locations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="805" y="185" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_payments" value="Payments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="25" y="245" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_chats" value="Chats" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="220" y="245" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_ratings" value="Ratings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="415" y="245" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_notifications" value="Notifications" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="610" y="245" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_chip_favorites" value="Favorites" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EBF5EB;strokeColor=#82b366;fontSize=12;" vertex="1" parent="tt_tier2">
          <mxGeometry x="805" y="245" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_t2_t3" value="stores and reads information" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#4D4D4D;strokeWidth=4;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tt_tier2" target="tt_tier3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_tier3" value="DATA LAYER — where everything is kept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1020" height="230" as="geometry" />
        </mxCell>
        <mxCell id="tt_pg" value="&lt;b&gt;Main Database&lt;/b&gt;&lt;br&gt;all records kept in organised,&#10;non-duplicated tables&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888888&quot;&gt;(PostgreSQL)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=top;spacingTop=18;" vertex="1" parent="tt_tier3">
          <mxGeometry x="70" y="50" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tt_media" value="&lt;b&gt;Media Files&lt;/b&gt;&lt;br&gt;ID photos, job pictures,&lt;br&gt;chat images and voice notes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888888&quot;&gt;(media folder served by the app server)&lt;/font&gt;" style="shape=folder;tabWidth=60;tabHeight=20;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=top;spacingTop=22;" vertex="1" parent="tt_tier3">
          <mxGeometry x="560" y="55" width="380" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tt_ext" value="EXTERNAL SERVICES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="360" height="650" as="geometry" />
        </mxCell>
        <mxCell id="tt_mail" value="&lt;b&gt;Email Sender&lt;/b&gt;&lt;br&gt;sends password-reset codes to users&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888888&quot;&gt;(SMTP over TLS :587)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="tt_ext">
          <mxGeometry x="25" y="60" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tt_inbox" value="Your Email Inbox" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="tt_ext">
          <mxGeometry x="25" y="240" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tt_money" value="&lt;b&gt;Mobile Money (MeSomb)&lt;/b&gt;&lt;br&gt;pays handymen safely via&lt;br&gt;MTN / Orange accounts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="tt_ext">
          <mxGeometry x="25" y="400" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_mail_inbox" value="delivers the code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="tt_ext" source="tt_mail" target="tt_inbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_srv_mail" value="asks it to send password emails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.5;endArrow=open;endFill=1;strokeColor=#9673a6;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tt_django" target="tt_mail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_srv_money" value="sends payment requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.85;entryX=0;entryY=0.35;endArrow=open;endFill=1;strokeColor=#b85450;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tt_django" target="tt_money">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tt_e_money_srv" value="confirms payment received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.95;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tt_money" target="tt_django">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
