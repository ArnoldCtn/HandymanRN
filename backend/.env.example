# Mobile / backend API endpoints
EXPO_PUBLIC_API_URL=http://localhost:8000

# MeSomb Configuration (Cameroon Mobile Money / payments)
# Copy this file to .env and add your actual credentials
MESOMB_ACCESS_KEY=your_mesomb_access_key_here
MESOMB_SECRET_KEY=your_mesomb_secret_key_here
MESOMB_APPLICATION_KEY=your_mesomb_application_key_here
MESOMB_WEBHOOK_SECRET=your_webhook_secret_here

# Environment
MESOMB_ENVIRONMENT=sandbox

# For ngrok testing (update with your ngrok URL)
NGROK_URL=your_ngrok_url_here

# Google Gemini API key (ID verification)
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo email API key
BREVO_API_KEY=your_brevo_api_key_here
DEFAULT_FROM_EMAIL=your_email@example.com

# Django
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=True
